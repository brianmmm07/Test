# Anthropic API Key for paper summarization
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Notion Integration Token
NOTION_TOKEN=your_notion_integration_token_here

# Notion Database ID where papers will be added
NOTION_DATABASE_ID=your_notion_database_id_here

# Keywords to search for - supports two formats:
# 1. Categorized (recommended): "Category1: keyword1, keyword2 | Category2: keyword3, keyword4"
# 2. Simple: "keyword1, keyword2, keyword3" (creates "General" category)
#
# Example with categories:
KEYWORDS=Image Generation: image generation, diffusion model, image editing | Video Generation: video generation, video extension, motion synthesis

# Or simple format:
# KEYWORDS=image generation,video generation,diffusion models

# Maximum papers to fetch per keyword per day
MAX_PAPERS_PER_KEYWORD=5

# Schedule time (24-hour format, e.g., 09:00)
SCHEDULE_TIME=09:00
